# Settings for offsite-backup.sh (server) and restore-drill.sh (owner's machine). D47, docs/DEPLOY.md.
# Server copy: /etc/goodbuild/offsite-backup.env, owner root, mode 600. NOT .env.production: that file
# reaches the web and worker containers, and these keys must not.
# Restore copy: ~/.config/goodbuild/restore.env, mode 600, with a READ-ONLY key instead.
# Values are plain (no quotes needed) and may not contain quotes, backslashes or spaces.

# Bucket. Example for Backblaze B2; the endpoint and region are on the bucket's page (UNVERIFIED format).
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=goodbuild-db-backups
# Optional folder inside the bucket, ending in "/".
S3_PREFIX=
# Server: a key that can only write to this bucket. Restore: a key that can only read it.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Server only. The owner's age PUBLIC key(s), one per line (age1...). Never the private key.
AGE_RECIPIENTS_FILE=/etc/goodbuild/backup-recipients.txt

# Server only. healthchecks.io ping URL (period 1 hour, grace 1 hour). Empty turns pings off.
HEALTHCHECK_URL=

# Server only, defaults shown. The compose project the dump is taken from.
#COMPOSE_FILE=/opt/goodbuild/deploy/docker-compose.yml
#COMPOSE_ENV_FILE=/opt/goodbuild/deploy/.env.production
#PG_SERVICE=goodbuild-postgres
