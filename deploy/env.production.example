# Copy to /opt/goodbuild/deploy/.env.production on the server (mode 600). Never commit real values.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_DOMAIN=goodbuildit.xyz
PUBLISHED_APPS_DOMAIN=goodbuildit.xyz
# Same domain with its dots escaped, for the Traefik rule.
PUBLISHED_APPS_DOMAIN_REGEX='goodbuildit\.xyz'
GEO_COUNTRY_HEADER=cf-ipcountry
TURN_CONCURRENCY=6
# How many built apps the run check opens at once (D67). The checker container is sized for 2 or 3.
RUN_CHECK_CONCURRENCY=2
# The type check (D68): warn, enforce or off. Start on warn and read the worker's "type check:" log lines before enforcing.
TYPE_CHECK=warn
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MAGIC_SECRET_KEY=
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# GitHub sync (D96): an OAuth App (not a GitHub App), callback https://goodbuildit.xyz/api/github/callback.
# When you register it, UNTICK "Expire user access tokens" (ticked by default): expiring tokens need a refresh flow that is not built. Runtime values: `up -d web worker`. Unset = the GitHub logo says it is not switched on.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_TEST_GD_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
# GoodBuild Credits on Celo (D51 to D55; see docs/DEPLOY.md). Unset = credits off on that chain.
CREDITS_CONTRACT_42220=
CREDITS_START_BLOCK_42220=
# Buy G$ or CELO with naira through GoodCash (D63). Runtime values, no rebuild: `up -d web`. Buy stays hidden until the publishable key is set.
# Register https://goodbuildit.xyz as an allowed site for the live key, and ask GoodCash to switch top-ups on.
GOODCASH_PUBLISHABLE_KEY=
GOODCASH_SECRET_KEY=
# Optional: a faster Celo node.
CELO_RPC_URL=
# Comma separated wallet addresses, any case. Not a build value, so a change needs `up -d web worker`, no rebuild.
# They may deploy to Celo mainnet in "admins" mode and change the mainnet switch (docs/DEPLOY.md, "The mainnet switch").
# Empty means nobody. The switch itself lives in the database and starts off.
ADMIN_WALLETS=

# Total real AI spend the free trial may reach, in millionths of a dollar (D29). Default $4. 0 turns free AI off.
# FREE_AI_BUDGET_MICRO=4000000
# Total free AI per verified person, in millionths of a dollar (D30). Default $0.70: the $0.20 plus $0.50.
# VERIFIED_CAP_MICRO=700000

# Optional. Cap on what all published apps may store together, in bytes (D31). Default 1 GB.
# APP_DATA_MAX_TOTAL_BYTES=

# --- GoodBuild Credits v2 (D56): pay with G$ against signed quotes -----------------------
# Set by deploy/launch-credits.sh on the server after the contract is deployed.
CREDITS_CONTRACT_42220=
CREDITS_START_BLOCK_42220=
# Private key the server signs G$ quotes with (its address is the contract's quoteSigner). Server only, never in git.
CREDITS_QUOTE_SIGNER_KEY=
# Extra on top of the G$ market price, in basis points (500 = 5%), for price moves and the cost of selling G$.
CREDITS_PRICE_BUFFER_BPS=500
# The expected G$ price in USD; quotes are refused if the live price is 5 times away from it.
GD_USD_FALLBACK=0.00011
