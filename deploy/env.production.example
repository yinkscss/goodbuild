# Copy to /opt/goodbuild/deploy/.env.production on the server (mode 600). Never commit real values.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_DOMAIN=goodbuildit.xyz
PUBLISHED_APPS_DOMAIN=goodbuildit.xyz
# Same domain with its dots escaped, for the Traefik rule.
PUBLISHED_APPS_DOMAIN_REGEX='goodbuildit\.xyz'
GEO_COUNTRY_HEADER=cf-ipcountry
TURN_CONCURRENCY=6
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MAGIC_SECRET_KEY=
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_TEST_GD_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=

# Total real AI spend the free trial may reach, in millionths of a dollar (D29). Default $4. 0 turns free AI off.
# FREE_AI_BUDGET_MICRO=4000000
