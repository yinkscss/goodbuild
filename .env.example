# Copy to .env.local for development. Never commit real secrets.

# --- Network -------------------------------------------------------------
# Stage 1 is testnet first (Celo Sepolia, 11142220). Who may deploy to Celo mainnet is a database
# setting, off by default, read on every request (D50). It is not an env or build value, so there
# is nothing to set here. To try it locally, set ADMIN_WALLETS and then change the setting as an admin:
#   curl -X PUT localhost:3000/api/mainnet -H 'content-type: application/json' -d '{"mode":"admins"}' (with your session cookie)
# Server only, comma separated. These wallets may use mainnet in "admins" mode and change the setting.
ADMIN_WALLETS=

# --- Auth (Magic + SIWE session, D22) ------------------------------------
# From https://dashboard.magic.link. In the dashboard, allow these RPC hosts in the
# content security policy: https://forno.celo.org and https://forno.celo-sepolia.celo-testnet.org
# Without the publishable key the app runs, but new sign-ins are switched off.
NEXT_PUBLIC_MAGIC_PUBLISHABLE_KEY=
# Server only: validates the Magic DID token on email sign-ins. Never NEXT_PUBLIC_.
MAGIC_SECRET_KEY=
# GoodBuild's test G$ on Celo Sepolia (D23). Deploy it once at /dev/test-gd.
NEXT_PUBLIC_TEST_GD_ADDRESS=
# Optional: your WalletConnect Cloud project id (https://cloud.reown.com). Also gives published apps
# WalletConnect (D36). Read at run time when an app is published. Without it they offer browser wallets and MiniPay only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# 32+ random characters; signs session and nonce cookies. Required in production.
#   openssl rand -base64 48
SESSION_SECRET=
# The host users sign in on, exactly as in the address bar (no scheme). Required in
# production; SIWE messages for any other domain are rejected.
APP_DOMAIN=localhost:3000
# Published apps live on <slug>.<this domain>. Defaults: goodbuildit.xyz in production, localhost in development.
# PUBLISHED_APPS_DOMAIN=goodbuildit.xyz
# Support and abuse address shown on /terms, /privacy and /report.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Vercel in front of Railway (D26). Leave empty for a single server. ---------
# On Vercel: where to forward /api, /a and published apps.
BACKEND_ORIGIN=
# On both: the shared secret. With this set and no BACKEND_ORIGIN, a server only accepts the edge.
EDGE_SECRET=
# On Vercel: keep this low (2). Each serverless instance opens its own database connections.
DATABASE_POOL_MAX=

# --- Database ------------------------------------------------------------
# Postgres connection string. Leave empty in development to use the embedded
# database in .data/ (created and migrated automatically).
DATABASE_URL=

# --- AI (M4) ----------------------------------------------------------------
# Vercel AI SDK talks to the providers directly from the server (D18). Keys stay
# server-side. Restart `pnpm dev` after changing them.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Development only: "1" replays a scripted tip-jar build instead of calling a model,
# so the workspace can be tried without keys. Refused in production.
GOODBUILD_DEMO_MODEL=
