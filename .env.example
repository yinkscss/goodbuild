# Copy to .env.local for development. Never commit real secrets.

# --- Network -------------------------------------------------------------
# Stage 1 is testnet first (Celo Sepolia, 11142220). "true" offers Celo mainnet.
NEXT_PUBLIC_ENABLE_MAINNET=false

# --- Auth (Privy + SIWE session) -----------------------------------------
# From https://dashboard.privy.io. Enable email + wallet login, and add Celo Sepolia.
# Without it the app runs, but sign-in is switched off.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: your WalletConnect Cloud project id (https://cloud.reown.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# 32+ random characters; signs session and nonce cookies. Required in production.
#   openssl rand -base64 48
SESSION_SECRET=
# The host users sign in on, exactly as in the address bar (no scheme). Required in
# production; SIWE messages for any other domain are rejected.
APP_DOMAIN=localhost:3000

# --- Database ------------------------------------------------------------
# Postgres connection string. Leave empty in development to use the embedded
# database in .data/ (created and migrated automatically).
DATABASE_URL=

# --- AI (M4) ----------------------------------------------------------------
# The app talks only to the LiteLLM proxy (D9, D14). Provider keys are read by the
# proxy, not the app. Start it with `pnpm llm` (needs: pip install 'litellm[proxy]').
LITELLM_BASE_URL=http://localhost:4000
# Shared secret between the app and the proxy: any long random string.
LITELLM_MASTER_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Development only: "1" replays a scripted tip-jar build instead of calling a model,
# so the workspace can be tried without keys. Refused in production.
GOODBUILD_DEMO_MODEL=
